# yt-downloader-go/.env — OPCIONAL: sin este fichero la app usa estos mismos valores por defecto.
# Prioridad: variable real del OS > .env > defecto. Solo hace falta tocarlo para cambiar algo.
APP_ENV=develop
APP_DEBUG=1
APP_NAME=eaf-yt-dl
APP_DEFAULT_LANG=es

# Por defecto: desde el repo, storage/logs y storage/downloads; como .exe suelto, logs/ y downloads/ junto al .exe.
#APP_LOG_PATH=%PATH_ROOT%/storage/logs
#APP_DOWNLOADS_PATH=%PATH_ROOT%/storage/downloads
